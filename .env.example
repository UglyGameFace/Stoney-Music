# Discord
DISCORD_TOKEN=replace_with_discord_bot_token
GUILD_ID=replace_with_server_id_for_instant_command_updates
MUSIC_TEXT_CHANNEL_ID=replace_with_music_command_channel_id
ROLE_VERIFIED=Verified
ROLE_RESIDENT=Resident

# Local Lavalink process started by start.sh
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=replace_with_a_long_random_password
LAVALINK_SECURE=false

# Optional deployment tuning
LAVALINK_VERSION=4.2.2
JAVA_OPTS=-Xms256M -Xmx900M
LAVALINK_WAIT_TIMEOUT=120
