# Discord
DISCORD_TOKEN=replace_with_discord_bot_token
# Optional: the bot auto-detects its server when connected to exactly one.
# GUILD_ID=
# Optional legacy default; /setup saves the selected channel.
# MUSIC_TEXT_CHANNEL_ID=

# Local Lavalink process started by src/bootstrap.js
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=replace_with_a_long_random_password
LAVALINK_SECURE=false

# Optional deployment tuning
LAVALINK_VERSION=4.2.2
JAVA_OPTS=-Xms256M -Xmx900M
LAVALINK_WAIT_TIMEOUT=120
# MUSIC_CONFIG_PATH=/home/node/data/guild-config.json
